{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"singleQuote": true,
	"jsxSingleQuote": true,
	"useTabs": true,
	"printWidth": 120,
	"sortPackageJson": {},
	"ignorePatterns": [
		"pnpm-lock.yaml",
		"**/.next",
		"**/.cloudflare",
		"**/.open-next",
		"**/.wrangler",
		"**/.adonisjs",
		"**/.vercel",
		"apps/api/build",
		"**/.turbo",
		"**/next-env.d.ts"
	]
}
