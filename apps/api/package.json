{
	"name": "@interval.so/api",
	"version": "0.0.0",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"imports": {
		"#controllers/*": "./app/controllers/*.js",
		"#exceptions/*": "./app/exceptions/*.js",
		"#models/*": "./app/models/*.js",
		"#mails/*": "./app/mails/*.js",
		"#services/*": "./app/services/*.js",
		"#listeners/*": "./app/listeners/*.js",
		"#events/*": "./app/events/*.js",
		"#middleware/*": "./app/middleware/*.js",
		"#validators/*": "./app/validators/*.js",
		"#providers/*": "./providers/*.js",
		"#generated/*": "./.adonisjs/server/*.js",
		"#transformers/*": "./app/transformers/*.js",
		"#database/*": "./database/*.js",
		"#start/*": "./start/*.js",
		"#config/*": "./config/*.js"
	},
	"scripts": {
		"build": "node ace build",
		"dev": "portless",
		"dev:app": "node ace serve --hmr",
		"dev:debug": "portless --script dev:debug:app",
		"dev:debug:app": "node --inspect ace serve --hmr",
		"migrate:apply": "drizzle-kit migrate",
		"migrate:create": "drizzle-kit generate",
		"start": "node bin/server.js",
		"test": "node --import=@poppinss/ts-exec --experimental-test-module-mocks --test tests/*.test.ts",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@adonisjs/core": "7.7.0",
		"@adonisjs/cors": "3.0.1",
		"@adonisjs/redis": "11.0.0",
		"@adonisjs/session": "8.4.0",
		"@better-auth/drizzle-adapter": "1.7.28",
		"@better-auth/passkey": "1.7.28",
		"@jonahsnider/util": "13.0.0",
		"@paralleldrive/cuid2": "3.3.0",
		"@rlanz/sentry": "^0.3.3",
		"@sentry/node": "11.19.0",
		"@sentry/profiling-node": "11.19.0",
		"@simplewebauthn/server": "14.1.0",
		"@trpc/server": "11.31.3",
		"@vinejs/vine": "4.4.0",
		"better-auth": "1.7.28",
		"convert": "8.2.0",
		"crypto-random-string": "6.0.0",
		"date-fns": "4.4.0",
		"drizzle-kit": "1.0.0-rc.6",
		"drizzle-orm": "1.0.0-rc.6",
		"posthog-node": "6.1.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"superjson": "2.2.7",
		"ts-pattern": "5.9.2",
		"ws": "8.23.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@adonisjs/assembler": "8.6.0",
		"@adonisjs/tsconfig": "2.0.0",
		"@poppinss/ts-exec": "1.5.2",
		"@types/node": "26.6.11",
		"@types/ws": "8.18.2",
		"execa": "10.2.1",
		"hot-hook": "1.1.0",
		"pino-pretty": "13.2.0",
		"typescript": "7.0.2",
		"youch": "4.1.1"
	},
	"hotHook": {
		"boundaries": [
			"./app/controllers/**/*.ts",
			"./app/routers/**/*.ts",
			"./app/**/*_controller.ts",
			"./app/**/*_router.ts",
			"./app/middleware/*.ts"
		]
	},
	"portless": {
		"name": "api.interval.so",
		"script": "dev:app"
	}
}
