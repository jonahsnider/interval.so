		"tailwindcss": "3.4.19",
		"tailwindcss-animate": "1.0.7",
		"typescript": "7.0.2",
		"use-mutative": "2.0.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@opennextjs/cloudflare": "1.20.18",
		"@types/node": "26.6.6",
		"cf": "1.0.0-rc.2",
		"wrangler": "4.165.0"
	},
	"portless": {
		"name": "interval.so",
		"proxy": true,
		"script": "dev:app"
	}
}
