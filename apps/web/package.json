{
	"name": "@interval.so/web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "NODE_ENV=production next build",
		"build:worker": "opennextjs-cloudflare build --skipWranglerConfigCheck && wrangler build --experimental-new-config --experimental-cf-build-output",
		"deploy": "pnpm build:worker && cf deploy --prebuilt",
		"dev": "portless",
		"dev:app": "NEXT_PUBLIC_API_URL=$(portless get api.interval.so) next dev",
		"preview": "pnpm build:worker && wrangler dev --experimental-new-config",
		"start": "next start",
		"type-check": "next typegen && tsc",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.27",
		"@heroicons/react": "2.2.0",
		"@hookform/resolvers": "7.0.7",
		"@interval.so/api": "workspace:*",
		"@jonahsnider/util": "13.0.0",
		"@posthog/next": "0.11.1",
		"@radix-ui/react-alert-dialog": "1.2.1",
		"@radix-ui/react-avatar": "1.3.1",
		"@radix-ui/react-checkbox": "^1.1.2",
		"@radix-ui/react-context-menu": "2.4.1",
		"@radix-ui/react-dialog": "^1.1.2",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/react-label": "2.1.17",
		"@radix-ui/react-popover": "1.3.1",
		"@radix-ui/react-portal": "1.2.0",
		"@radix-ui/react-progress": "1.2.1",
		"@radix-ui/react-scroll-area": "^1.2.1",
		"@radix-ui/react-select": "2.4.1",
		"@radix-ui/react-separator": "1.2.0",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-switch": "1.4.1",
		"@radix-ui/react-tabs": "1.2.1",
		"@radix-ui/react-tooltip": "1.4.1",
		"@sentry/nextjs": "^11.0.0",
		"@simplewebauthn/browser": "14.0.0",
		"@tanstack/react-query": "5.108.2",
		"@tanstack/react-table": "9.3.1",
		"@trpc/client": "11.29.5",
		"@trpc/tanstack-react-query": "11.29.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vercel/functions": "3.11.3",
		"autoprefixer": "10.7.0",
		"better-auth": "1.7.27",
		"chrono-node": "2.10.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "^1.0.0",
		"convert": "8.2.0",
		"date-fns": "4.4.0",
		"fuse.js": "7.5.0",
		"motion": "14.14.0",
		"mutative": "2.0.2",
		"next": "16.4.6",
		"next-plausible": "4.0.0",
		"next-themes": "0.4.6",
		"nuqs": "2.10.3",
		"postcss": "8.5.33",
		"postcss-import": "17.0.1",
		"react": "19.3.1",
