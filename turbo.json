{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"]
		},
		"@interval.so/api#build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**"]
		},
		"@interval.so/web#build": {
			"dependsOn": ["^build"],
			"env": ["API_URL", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_SENTRY_DSN", "POSTHOG_HOST", "POSTHOG_KEY"],
			"outputs": [".next/**", "!.next/cache/**"],
			"passThroughEnv": ["SENTRY_AUTH_TOKEN", "VERCEL_OIDC_TOKEN"]
		},
		"type-check": {
			"dependsOn": ["^type-check"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
