{
	"$schema": "https://turbo.build/schema.json",
	"cacheMaxSize": "2GB",
	"globalDependencies": [".env*"],
	"globalEnv": ["NODE_ENV"],
	"tasks": {
		"//#lint": {},
		"//#format": {},
		"//#lint:fix": {
			"cache": false
		},
		"//#format:write": {
			"cache": false
		},
		"test": {
			"inputs": ["$TURBO_DEFAULT$", ".env*"]
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"]
		},
		"type-check": {
			"dependsOn": ["^type-check"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"]
		},
		"dev": {
			"persistent": true,
			"cache": false,
			"passThroughEnv": ["*"]
		}
	}
}
