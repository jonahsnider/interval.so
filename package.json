{
	"name": "interval.so",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "oxfmt --check",
		"format:write": "oxfmt --write",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
		"test": "turbo run lint format build type-check test",
		"type-check": "turbo run type-check"
	},
	"devDependencies": {
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "^7.0.2001",
		"portless": "0.15.8",
		"railway": "3.16.0",
		"turbo": "2.11.9",
		"vercel": "64.5.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.14.0"
}
