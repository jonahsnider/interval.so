{
	"name": "interval.so",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "prettier --check .",
		"format:write": "pnpm format --write",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"test": "pnpm lint && pnpm format && turbo run build type-check",
		"type-check": "turbo run type-check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"prettier": "3.9.6",
		"prettier-plugin-packagejson": "3.0.2",
		"turbo": "2.10.12",
		"vercel": "59.5.0"
	},
	"packageManager": "pnpm@12.0.0",
	"engines": {
		"node": "24.x"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		}
	}
}
