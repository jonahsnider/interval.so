{
	"name": "interval.so",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "oxfmt --check",
		"format:write": "oxfmt --write",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
		"test": "pnpm lint && pnpm format && turbo run build type-check",
		"type-check": "turbo run type-check"
	},
	"devDependencies": {
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "^7.0.2001",
		"portless": "0.15.7",
		"railway": "3.13.1",
		"turbo": "2.11.7",
		"vercel": "63.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.11.2"
}
