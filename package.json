{
	"name": "interval.so",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "oxfmt --check",
		"format:write": "oxfmt --write",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
		"test": "pnpm lint && pnpm format && turbo run build type-check",
		"type-check": "turbo run type-check"
	},
	"devDependencies": {
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"railway": "3.11.0",
		"turbo": "2.10.12",
		"vercel": "59.11.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.2.1"
}
